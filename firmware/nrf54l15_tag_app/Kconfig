source "Kconfig.zephyr"

menu "PuttTrack Tag options"


config PUTTTRACK_MOTION_DEMO_V0
	bool "Enable the research-only on-Ball motion-state demo"
	default n
	help
	  Run the frozen stationary-start pickup hypothesis and a conservative
	  rolling-candidate display state at the existing 50 Hz stream rate. The
	  result is exposed through encrypted custom mcumgr command 24 with
	  authority=false. It never changes strokes, scores, hole state or penalties.
	  Sensor errors and timing faults fail closed to UNKNOWN_QUALITY. Gyro
	  clipping blocks pickup confirmation; a generic saturated-rotation candidate
	  may remain visible with an explicit quality flag.

config PUTTTRACK_STROKE_PICKUP_V1
    bool "Research-only stroke/pickup shadow V1 (commands 25/26)"
    depends on !PUTTTRACK_MOTION_DEMO_V0
    default n
    help
      Run a 50 Hz generic candidate engine with explicit event history.
      Candidate counts are not gameplay strokes; pickup is not cheating truth.
      Command 26 starts an explicitly operator-delimited bench trial only.

config PUTTTRACK_NFC_SERVICE
	bool "Enable the experimental NFC service record"
	default n
	help
	  Build the read-only Type 2 Tag NDEF service record and one-shot bounded
	  fast-BLE discovery window used by the PCA20072 NFC feasibility experiment.
	  This option does not make NFC an authenticated transport and does not
	  replace encrypted BLE SMP or signed OTA.

config PUTTTRACK_NFC_SYSTEM_OFF_TEST
	bool "Enable explicit NFC System OFF wake experiment"
	depends on PUTTTRACK_NFC_SERVICE
	default n
	help
	  Add an encrypted BLE SMP command that enters System OFF after a short
	  delay. NFC field sensing remains armed as a wake source. This is an
	  explicit laboratory operation only; normal power policies never enter
	  System OFF automatically.

endmenu
